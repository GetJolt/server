# Copy to .env for docker compose, or export these in your shell when running the server directly.

# The public domain (plus the port, if it isn't 443) that people and other instances use to reach you.
# It becomes part of every local account's address, so pick it once.
JOLT_DOMAIN=chat.example.org
JOLT_NAME=My Jolt instance
JOLT_DESCRIPTION=

# open, invite (needs one of JOLT_REGISTRATION_CODES) or closed
JOLT_REGISTRATION=open
JOLT_REGISTRATION_CODES=

# open, allowlist (only JOLT_FEDERATION_ALLOW) or disabled. Blocked instances are always refused.
JOLT_FEDERATION=open
JOLT_FEDERATION_ALLOW=
JOLT_FEDERATION_BLOCK=
JOLT_ALLOW_REMOTE_GUILD_CREATION=false

# These have sensible defaults. The Docker image already stores SQLite in its /data volume.
# JOLT_DATABASE=./data/jolt.sqlite   (or postgres://user:password@host:5432/jolt)
# JOLT_HOST=0.0.0.0
# JOLT_PORT=4000
# JOLT_TRUST_PROXY=false             (set to true behind a reverse proxy)
# JOLT_LOG_LEVEL=info

# Development only: federate over plain http and allow private addresses.
# JOLT_DEV_INSECURE=true

# Seals the tokens of linked Bluesky and Mastodon accounts. If unset, a key is generated and kept in secret.key
# next to the SQLite database. Set it yourself when using Postgres, and keep it safe: losing it means people have
# to link their accounts again.
# JOLT_SECRET_KEY=
