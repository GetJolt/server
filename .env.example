# Public domain (and port, if not 443) other instances and clients use to reach this server.
JOLT_DOMAIN=localhost:4000
JOLT_HOST=0.0.0.0
JOLT_PORT=4000
JOLT_NAME=My Jolt instance
JOLT_DESCRIPTION=
# SQLite file path, or a postgres:// connection string.
JOLT_DATABASE=./data/jolt.sqlite
# open | invite | closed
JOLT_REGISTRATION=open
JOLT_REGISTRATION_CODES=
# open | allowlist | disabled
JOLT_FEDERATION=open
JOLT_FEDERATION_ALLOW=
JOLT_FEDERATION_BLOCK=
JOLT_ALLOW_REMOTE_GUILD_CREATION=false
# Set behind a reverse proxy so rate limits see real client IPs.
JOLT_TRUST_PROXY=false
# Development only: talk to other instances over plain http and allow private addresses.
JOLT_DEV_INSECURE=false
